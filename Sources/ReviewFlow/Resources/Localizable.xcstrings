            "state": "translated",
            "value": "Das tut uns leid"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentimos muito por isso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нам жаль это слышать"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci dispiace"
          }
        }
      }
    },
    "review_flow.feedback_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'd love to hear how we can improve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉我们如何改进吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴我們可以如何改進。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "改善のためにご意見をお聞かせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떻게 개선하면 좋을지 알려주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos encantaría saber cómo podemos mejorar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-nous comment nous pouvons nous améliorer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag uns gern, wie wir uns verbessern können."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostaríamos de saber como podemos melhorar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите, как мы можем стать лучше."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci piacerebbe sapere come possiamo migliorare."
          }
        }
      }
    },
