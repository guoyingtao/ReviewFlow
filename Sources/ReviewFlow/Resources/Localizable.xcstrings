        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres dejar una valoración o enviarnos comentarios?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez-vous laisser une note ou nous faire un retour ?"
