    "review_flow.feedback_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're Sorry to Hear That"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很抱歉给你带来不便"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "很抱歉造成不便"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご期待に添えず申し訳ありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불편을 드려 죄송합니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lamentamos que no sea así"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous en sommes désolés"
          }
        },
        "de": {
