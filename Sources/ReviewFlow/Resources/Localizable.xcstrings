    "review_flow.rate_choice_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Would you like to leave a rating or send us feedback?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想给个评分，还是给我们一些反馈？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想給個評分，還是提供一些意見回饋？"
